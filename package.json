{
  "name": "silla-vida",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-netlify-headers.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "audit": "node scripts/performance-audit.js",
    "optimize-images": "node scripts/generate-responsive-images.js",
    "analyze": "cross-env ANALYZE=true vite build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:regression": "jest src/tests/shopify-regression.test.ts src/tests/judgeme-integration.test.ts --verbose",
    "test:shopify": "jest src/tests/shopify-regression.test.ts --verbose",
    "test:judgeme": "jest src/tests/judgeme-integration.test.ts --verbose",
    "test:monitoring": "jest src/tests/monitoring.test.ts --verbose",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:a11y": "cypress run --spec 'cypress/e2e/accessibility.cy.js'",
    "test:ci": "npm run test:regression && npm run test:coverage",
    "monitor:start": "node scripts/start-monitoring.js",
    "monitor:health": "node scripts/health-check.js"
  },
  "dependencies": {
    "@shopify/hydrogen-react": "^2024.1.1",
    "@types/react-helmet": "^6.1.11",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-intersection-observer": "^9.16.0",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.15.3",
    "workbox-window": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@eslint/js": "^9.9.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "axe-core": "^4.10.3",
    "chalk": "^4.1.2",
    "chrome-launcher": "^1.1.0",
    "cross-env": "^7.0.3",
    "cypress": "^14.3.2",
    "cypress-axe": "^1.6.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "glob": "^10.3.10",
    "globals": "^15.9.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-transform-stub": "^2.0.0",
    "lighthouse": "^11.7.0",
    "msw": "^2.7.6",
    "postcss": "^8.4.35",
    "rollup-plugin-visualizer": "^5.14.0",
    "sharp": "^0.33.2",
    "tailwindcss": "^3.4.1",
    "terser": "^5.39.0",
    "ts-jest": "^29.3.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.18",
    "vite-plugin-imagemin": "^0.6.1"
  }
}
